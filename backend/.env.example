# Copy to .env and adjust for your local PostgreSQL install.
DATABASE_URL=postgresql+psycopg://localhost/cafe_fausse
TEST_DATABASE_URL=postgresql+psycopg://localhost/cafe_fausse_test
FLASK_APP=app
# Comma-separated origins allowed to call the API directly (the Vite dev proxy doesn't need this).
CORS_ORIGINS=http://localhost:5173
