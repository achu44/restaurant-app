# Local settings for the Flask API. Copy to .env (never commit .env) and adjust if needed.
# See docs/developer-guide.md, step 3 for how to create this role and these databases.

# Main development database
DATABASE_URL=postgresql+psycopg://cafe_fausse:cafe_fausse@localhost:5432/cafe_fausse

# Used ONLY by pytest. The test suite DROPS and recreates every table in this database,
# so never point it at a database whose data you want to keep.
TEST_DATABASE_URL=postgresql+psycopg://cafe_fausse:cafe_fausse@localhost:5432/cafe_fausse_test

# Lets you run `flask <command>` without --app, on the port the React dev server proxies to.
FLASK_APP=app
FLASK_RUN_PORT=5001
# Auto-reload on code changes. Never enable debug mode on a public server.
FLASK_DEBUG=1

# Origins allowed to call the API directly from a browser (the Vite proxy doesn't need this).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
